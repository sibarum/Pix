<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sibarum</groupId>
        <artifactId>pix</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>pix-core</artifactId>

    <name>pix-core</name>
    <description>
        The controller: the editor, which decides, and the jobs that touch the disk. Reached only by messages.
    </description>

    <!--
      What the controller may build against, and what it may not. It may use the framework's vocabulary, the bus, and
      vexelray-gui-core's values (a span, a colour, the settings store), all of which are safe from any thread. It may
      not use a widget, the window or the shell: those are -gui's, and a widget here would put the view back inside
      the controller. Nothing enforces that but this list, so a dependency added here is a decision about where the
      line is.
    -->
    <dependencies>
        <!-- @Component, @Job, @Subscribe, @Publishes, @Configuration: checked by the processor while this compiles. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-api</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- The command line's paths (Launch), which the editor opens once the window exists. JDK-only. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-core</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- Span, Color and Settings, and through it the bus (atchung-core) and the logger (atchung-probe). -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Pictures: decoding every format imagelib reads, on a job. No widget of it is used here. -->
        <dependency>
            <groupId>dev.vexelray.codec</groupId>
            <artifactId>vexelray-codec-image</artifactId>
            <version>${vexelray-codec.version}</version>
        </dependency>
        <!-- Videos: a poster and a video's facts on a job, and its frames and sound played through the codec's Player (FFmpeg). -->
        <dependency>
            <groupId>dev.vexelray.codec</groupId>
            <artifactId>vexelray-codec-video</artifactId>
            <version>${vexelray-codec.version}</version>
        </dependency>
        <!-- Convert's Video: a picture that plays written as AV1 in WebM (Recording, ffmpeg-wrapper-record), on a job.
             The same encoder -gui's title bar records the window with. -->
        <dependency>
            <groupId>dev.vexelray.codec</groupId>
            <artifactId>vexelray-codec-record</artifactId>
            <version>${vexelray-codec.version}</version>
        </dependency>
        <!-- Convert.rasterToSdg: a picture traced into an SDG drawing (docs/trace.md), on a job. -->
        <dependency>
            <groupId>dev.vexelray.fields</groupId>
            <artifactId>vexelray-fields-convert</artifactId>
            <version>${vexelray-fields.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>
</project>
