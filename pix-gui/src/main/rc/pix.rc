// The executable's icon and version resource, linked into pix.exe (-Pnative-release) and pix-debug.exe (-Pnative).
//
// Ordinal 1, and it is the only icon here, because Windows shows a program's *lowest-numbered* icon resource
// wherever it shows the program itself -- Explorer, the taskbar's pinned button, a shortcut, the Apps entry.
//
// The running window wears the same file: the build makes pix.ico from pix.svg (the icon plugin's pair goal, an
// SDG rendered at every size Windows asks for, 16 to 256 px), puts it on the class path, where @VexelApp's icon
// names it, and in target/generated-rc, where rc.exe finds it by /i. So the window, its taskbar button and the .exe
// cannot drift apart, and no .ico is committed: change pix.svg.
1 ICON "pix.ico"

// The manifest: PerMonitorV2 DPI awareness and the OS compatibility java.exe declares, so this executable is
// drawn at the display's real pixels exactly as a JVM launch is, rather than rendered at 96 DPI and stretched by
// Windows. Resource 1 of type 24 (RT_MANIFEST) is the one the loader reads for a process.
1 24 "pix.manifest"

// The version resource. FileDescription is the program's name wherever Windows names the program rather than a
// file: Open with, Task Manager, the taskbar. Without it Windows falls back to the file name. The pom's
// compile-icon-resource passes the VI_ defines; VI_STR makes the version a string.
#define VI_STR2(x) #x
#define VI_STR(x) VI_STR2(x)

1 VERSIONINFO
FILEVERSION     VI_MAJOR,VI_MINOR,VI_PATCH,0
PRODUCTVERSION  VI_MAJOR,VI_MINOR,VI_PATCH,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "sibarum"
            VALUE "FileDescription", "Rasterware"
            VALUE "ProductName", "Rasterware"
            VALUE "FileVersion", VI_STR(VI_VERSION)
            VALUE "ProductVersion", VI_STR(VI_VERSION)
            VALUE "OriginalFilename", VI_STR(VI_IMAGE)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
