{
  "id": "pix",
  "name": "Pix",
  "publisher": "sibarum",
  "description": "An image viewer: one picture, as large as the window allows, and the rest of its folder a key press away.",
  "version": "0.1.0",

  "repo": "sibarum/vexelray-dist",
  "branch": "main",
  "repoPath": "apps/pix",
  "releasesRepo": "sibarum/vexelray-dist",
  "tagFormat": "pix-v{version}",

  "windows": {
    "binaries": [
      {
        "name": "pix",
        "source": "target/pix.exe",
        "icon": "src/main/rc/pix.ico",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "Pix" },
        "fileAssociations": [
          { "extension": ".png", "description": "PNG Image", "contentType": "image/png", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".apng", "description": "Animated PNG Image", "contentType": "image/apng", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".jpg", "description": "JPEG Image", "contentType": "image/jpeg", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".jpeg", "description": "JPEG Image", "contentType": "image/jpeg", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".jfif", "description": "JPEG Image", "contentType": "image/jpeg", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".gif", "description": "GIF Image", "contentType": "image/gif", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".webp", "description": "WebP Image", "contentType": "image/webp", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".avif", "description": "AVIF Image", "contentType": "image/avif", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".bmp", "description": "Bitmap Image", "contentType": "image/bmp", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".tif", "description": "TIFF Image", "contentType": "image/tiff", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".tiff", "description": "TIFF Image", "contentType": "image/tiff", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".svg", "description": "SVG Image", "contentType": "image/svg+xml", "icon": "src/main/rc/file-vector-graphics.ico" },
          { "extension": ".ico", "description": "Icon", "contentType": "image/x-icon", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".tga", "description": "Targa Image", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".qoi", "description": "QOI Image", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".pnm", "description": "Portable Anymap Image", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".pbm", "description": "Portable Bitmap Image", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".pgm", "description": "Portable Graymap Image", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".ppm", "description": "Portable Pixmap Image", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".dds", "description": "DirectDraw Surface", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".exr", "description": "OpenEXR Image", "icon": "src/main/rc/file-images.ico" },
          { "extension": ".hdr", "description": "Radiance HDR Image", "icon": "src/main/rc/file-images.ico" }
        ]
      },
      {
        "name": "pix-ffmpeg",
        "source": "target/pix-ffmpeg-windows-x86_64.zip",
        "dir": "ffmpeg"
      },
      { "name": "notices", "source": "THIRD-PARTY-NOTICES.txt" }
    ]
  }
}
