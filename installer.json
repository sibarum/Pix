{
  "id": "pix",
  "name": "Pix",
  "publisher": "sibarum",
  "description": "An image viewer: one picture, as large as the window allows, and the rest of its folder a key press away.",
  "version": "0.1.0",

  "repo": "sibarum/vexelray-dist",
  "branch": "main",
  "repoPath": "apps/pix",
  "releasesRepo": "sibarum/vexelray-dist",
  "tagFormat": "pix-v{version}",

  "windows": {
    "binaries": [
      {
        "name": "pix",
        "source": "target/pix.exe",
        "icon": "src/main/rc/pix.ico",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "Pix" },
        "fileAssociations": [
          { "extension": ".png", "description": "PNG Image", "contentType": "image/png" },
          { "extension": ".apng", "description": "Animated PNG Image", "contentType": "image/apng" },
          { "extension": ".jpg", "description": "JPEG Image", "contentType": "image/jpeg" },
          { "extension": ".jpeg", "description": "JPEG Image", "contentType": "image/jpeg" },
          { "extension": ".jfif", "description": "JPEG Image", "contentType": "image/jpeg" },
          { "extension": ".gif", "description": "GIF Image", "contentType": "image/gif" },
          { "extension": ".webp", "description": "WebP Image", "contentType": "image/webp" },
          { "extension": ".avif", "description": "AVIF Image", "contentType": "image/avif" },
          { "extension": ".bmp", "description": "Bitmap Image", "contentType": "image/bmp" },
          { "extension": ".tif", "description": "TIFF Image", "contentType": "image/tiff" },
          { "extension": ".tiff", "description": "TIFF Image", "contentType": "image/tiff" },
          { "extension": ".svg", "description": "SVG Image", "contentType": "image/svg+xml" },
          { "extension": ".ico", "description": "Icon", "contentType": "image/x-icon" },
          { "extension": ".tga", "description": "Targa Image" },
          { "extension": ".qoi", "description": "QOI Image" },
          { "extension": ".pnm", "description": "Portable Anymap Image" },
          { "extension": ".pbm", "description": "Portable Bitmap Image" },
          { "extension": ".pgm", "description": "Portable Graymap Image" },
          { "extension": ".ppm", "description": "Portable Pixmap Image" },
          { "extension": ".dds", "description": "DirectDraw Surface" },
          { "extension": ".exr", "description": "OpenEXR Image" },
          { "extension": ".hdr", "description": "Radiance HDR Image" }
        ]
      }
    ]
  }
}
